{
  "name": "extrema",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run clean:next && next build",
    "start": "next start",
    "typecheck": "npm run clean:next && next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "backend:dev": "npm --prefix backend run dev",
    "backend:check": "npm --prefix backend run check",
    "check:all": "npm run check && npm run backend:check",
    "clean:next": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@circle-fin/w3s-pw-web-sdk": "1.1.11",
    "@tanstack/react-query": "5.100.10",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "2.56.3",
    "wagmi": "3.7.7"
  },
  "overrides": {
    "undici": "6.28.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^7.0.2"
  }
}
