# EXTREMA frontend - Arc Testnet only
# Copy to .env.local for local development. Do not commit .env.local.

# Server-side Next.js proxy -> EXTREMA backend
BACKEND_API_URL=http://127.0.0.1:3001/api

# Circle user-controlled wallet browser configuration.
# These are public client configuration values, not backend secrets.
NEXT_PUBLIC_CIRCLE_APP_ID=
NEXT_PUBLIC_CIRCLE_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_CIRCLE_GOOGLE_REDIRECT_URI=http://localhost:3000/wallet

# Optional external-wallet provider project id.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
