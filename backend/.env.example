NODE_ENV=development
PORT=3001

# Railway Postgres supplies DATABASE_URL automatically when linked.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/extrema

# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Generate with: openssl rand -hex 32
JWT_SECRET=

# Comma-separated frontend origins.
# Codespaces example:
# https://YOUR-CODESPACE-3000.app.github.dev
CORS_ORIGINS=http://localhost:3000

# Production should set both values explicitly.
# In development, Codespaces/localhost origins can derive the exact RP ID dynamically.
WEBAUTHN_RP_NAME=EXTREMA
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=http://localhost:3000

JWT_TTL_SECONDS=604800

# Temporary for Codespaces testing only. Disable for final production frontend.
ALLOW_CODESPACE_ORIGINS=false

ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Public deployed EXTREMA Factory on Arc Testnet.
EXTREMA_FACTORY_ADDRESS=0xa7Bff22811Bb1BA9297DFaA611De58E3bc186D7A
