# EXTREMA backend - Arc Testnet only
NODE_ENV=development
PORT=3001

# Local development database only. Deployment database credentials are secrets
# and are intentionally not included in this template.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/extrema

# Generate local-only values with: openssl rand -hex 32
ENCRYPTION_KEY=
JWT_SECRET=

# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:3000
JWT_TTL_SECONDS=604800

# Arc Testnet read/write RPC. Writes remain primary-only.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_TESTNET_RPC_FALLBACK_URL=https://rpc.solidrpc.io/public/evm/5042002
ARC_RPC_READ_CONCURRENCY=8

# Gateway source-chain read RPCs.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_RPC_FALLBACK_URL=https://base-sepolia-rpc.publicnode.com
OP_SEPOLIA_RPC_URL=https://sepolia.optimism.io
OP_SEPOLIA_RPC_FALLBACK_URL=https://optimism-sepolia-rpc.publicnode.com
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC_FALLBACK_URL=https://arbitrum-sepolia-rpc.publicnode.com
ETHEREUM_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHEREUM_SEPOLIA_RPC_FALLBACK_URL=https://public.1rpc.io/sepolia

# Canonical Arc Testnet deployment.
EXTREMA_FACTORY_ADDRESS=0xa7Bff22811Bb1BA9297DFaA611De58E3bc186D7A
EXTREMA_MARKETPLACE_ADDRESS=0x0C50FE3edD739B7268d58E1414F973e9A55dd037

# Fail-closed write/automation gates for a fresh clone.
EXTREMA_ENABLE_ROUND_CREATION=false
EXTREMA_ENABLE_SEED_BOTS=false
EXTREMA_ENABLE_GATEWAY_BROADCAST=false

# Deployment credentials such as Circle API credentials and encrypted resolver
# material are intentionally omitted. See docs/SECURITY_OPERATIONS.md.
